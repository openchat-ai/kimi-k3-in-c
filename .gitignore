# build output
build/
bin/
*.o
*.a
*.so
*.exe
*.obj
compile_commands.json

# corrupt/exploratory experiments; never commit these
/_bak_corrupt/

# full-model safetensors index blob (497K lines); shard map lives beside the weights
/model.safetensors.index.json

# Model weights and derived data. Hundreds of gigabytes; never commit these.
# The patterns are broad on purpose; test fixtures are re-included at the bottom.
*.safetensors
trunk.bin
trunk.json
k3model/
k3trunk/
*.gguf

# Run artifacts. Anchored to the repository root so that a stray `k3_run.json` in the
# working directory is ignored while an identically-named fixture is not.
/*.log
/k3_run.json
/expert_trace.bin
/expert_hist.json
/st_index.json
/st_values.json
/out/
/results/

